<%= link_to "← Voltar ao catálogo", catalogo_path %>

<div class="produto-detalhe">
  <% if @produto.imagens.attached? %>
    <div class="galeria" data-galeria data-atual="0">
      <div class="galeria-miniaturas">
        <% @produto.imagens.each_with_index do |imagem, i| %>
          <button type="button"
                  class="miniatura <%= 'ativa' if i.zero? %>"
                  data-miniatura
                  data-indice="<%= i %>"
                  data-src="<%= url_for(imagem) %>">
            <%= image_tag imagem, alt: "Foto #{i + 1}" %>
          </button>
        <% end %>
      </div>

      <div class="galeria-principal">
        <%= image_tag @produto.imagens.first, data: { principal: true }, alt: @produto.nome %>

        <button type="button" class="seta seta-anterior" data-anterior aria-label="Foto anterior">
          <i class="bi bi-chevron-left"></i>
        </button>
        <button type="button" class="seta seta-proxima" data-proxima aria-label="Próxima foto">
          <i class="bi bi-chevron-right"></i>
        </button>
      </div>
    </div>
  <% end %>

  <div class="produto-info">
    <h1><%= @produto.nome %></h1>
    <p class="preco"><%= preco_br(@produto.preco) %></p>

    <%= form_with url: line_items_path, method: :post, class: "form-compra" do |form| %>
      <%= form.hidden_field :produto_id, value: @produto.id %>
      <%= form.number_field :quantidade, value: 1, min: 1 %>
      <%= form.submit "Comprar" %>
    <% end %>

    <div class="descricao">
      <%= simple_format(@produto.descricao) %>
    </div>
  </div>
</div>