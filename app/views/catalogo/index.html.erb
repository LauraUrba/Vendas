<h1>Catalogo</h1>


<%= form_with url: catalogo_path, method: :get, class: "busca" do |form| %>
  <%= form.text_field :busca, value: params[:busca], placeholder: "Buscar produtos..." %>
  <%= form.submit "Buscar" %>
<% end %>

<% if @produtos.empty? %>
  <p>Nenhum produto encontrado.</p>
<% end %>

<div class="catalogo-grid">
  <% @produtos.each do |produto| %>
    <div class="produto">
      <% if produto.imagens.attached? %>
        <%= link_to image_tag(produto.imagens.first), catalogo_produto_path(produto) %>
      <% end %>

      <h2><%= link_to produto.nome, catalogo_produto_path(produto) %></h2>
      <p><%= truncate(produto.descricao, length: 100) %></p>
      <p>
        <span class="preco">
          <%= number_to_currency(produto.preco, unit: "R$ ", separator: ",", delimiter: ".") %>
        </span>
      </p>
    </div>
  <% end %>
</div>